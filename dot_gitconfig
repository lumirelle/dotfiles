# User Information
[user]
name = Lumirelle
email = shabbyacc@outlook.com
[credential "https://gitee.com"]
provider = generic

# Core Settings
[core]
ignorecase = false
editor = nvim # Or replace with your preferred editor.
[feature]
# Will enable some default configurations to better handle a large number of files, include "index.version=4".
# See https://git-scm.com/docs/git-config#Documentation/git-config.txt-featuremanyFiles.
manyFiles = true

# Include additional configuration files based on the current repository path.
[includeIf "gitdir:~/workon/"]
path = .gitconfig-work

# Repository Initialization
[init]
defaultBranch = main

[blame]
ignoreRevsFile = ":(optional).git-blame-ignore-revs"
# See https://www.michaelheap.com/git-ignore-rev/
markIgnoredLines = true
markUnblamableLines = true

# Working with Branches
[branch]
sort = -committerdate
[diff]
algorithm = histogram
context = 5
[merge]
autostash = true
conflictstyle = zdiff3
ff = no
[rebase]
autostash = true
autosquash = true
[rerere]
enabled = true
[tag]
sort = taggerdate

# Working with Remotes
[fetch]
prune = true
pruneTags = true
[pull]
rebase = true
[push]
autoSetupRemote = true
default = current
followTags = true

# Log
[log]
date = short
decoration = short

# Aliases
# We use -?/--? to trigger the help message for each alias, which is implemented in the corresponding shell function.
[alias]
me = !bash ~/.gitaliases me
discard = !bash ~/.gitaliases discard
disadd = !bash ~/.gitaliases disadd
uncommit = reset --soft HEAD^ # Back to the staging area
commit-wip = commit --message 'wip: working in progress'
commit-readme = commit --message 'docs: update README.md'
commit-deps = commit --message 'chore: update non-major dependencies'
# It's HIGHLY RECOMMENDED to use "Pull Request" on hosting platforms for merging branches,
# but this alias can be helpful when you do want to merge locally.
justmerge = !bash ~/.gitaliases justmerge
log1 = log -1 HEAD --stat
logs = log HEAD --stat
logg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

# Global Hooks
[hook "hk-pre-commit"]
# It seems like --from-hook does not work well (maybe this is caused by using Windows)
# So we test hk.pkl here explicitly
command = test "${HK:-1}" = "0" || ! test -e hk.pkl || hk run pre-commit --from-hook --staged "$@"
event = pre-commit
