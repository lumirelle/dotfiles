amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // Code
  ["gotmplfmt"] {
    glob = List(".chezmoiignore", "**/*.tmpl")
    check_list_files = new CommandSpec {
      command = new Command {
        argv = List("node", "./scripts/gotmplfmt-check.js", "{{ files }}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("gotmplfmt", "-w", "{{ files }}")
      }
      effect = "write"
    }
  }
  ["oxlint"] = Builtins.ox_lint
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob =
      List(
        // Code
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.mts",
        "*.cts",
        "*.tsx",
        // Configurations
        "*.json",
        "*.jsonc",
        "*.yaml",
        "*.yml",
        "*.toml",
        // Documentations
        "*.md",
        "*.mdc",
        "*.mdx",
      )
    check = new CommandSpec {
      command = new Command { argv = List("eslint", "--no-warn-ignored", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("eslint", "--no-warn-ignored", "--fix", "{{files}}")
      }
      effect = "write"
    }
    depends = List("oxlint")
  }
  ["stylua"] = Builtins.stylua
  ["nufmt"] {
    glob = List("**/*.nu")
    check = new CommandSpec {
      command = new Command {
        argv = List("nufmt", "--dry-run", "{{ files }}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("nufmt", "{{ files }}")
      }
      effect = "write"
    }
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any =
      List(
        new FileSelector {
          glob =
            List(
              // Code
              "dot_gitconfig",
              "dot_gitaliases",
              "dot_profile",
              // Configurations
              "**/.editorconfig",
              "**/.gitattributes",
              "**/.gitignore",
              "**/.npmrc",
            )
        },
        new FileSelector { types = List("sh", "bash") },
      )
  }

  // Configurations
  ["hk"] {
    glob = List("hk.pkl")
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate") }
      effect = "read"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    stage = false
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
