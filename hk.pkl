amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // Code
  ["gotmplfmt"] {
    glob = List(".chezmoiignore", "**/*.tmpl")
    check_list_files = "node ./scripts/gotmplfmt-check.js {{ files }}"
    fix = "gotmplfmt -w {{ files }}"
  }
  ["oxlint"] = Builtins.ox_lint
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob =
      List(
        // Code
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.mts",
        "*.cts",
        "*.tsx",
        // Configurations
        "*.json",
        "*.jsonc",
        "*.yaml",
        "*.yml",
        "*.toml",
        // Documentations
        "*.md",
        "*.mdc",
        "*.mdx",
      )
    depends = List("oxlint")
  }
  ["stylua"] = (Builtins.stylua) {
    glob = List("**/*.lua")
  }
  ["nufmt"] {
    glob = List("**/*.nu")
    check = "nufmt --dry-run {{ files }}"
    fix = "nufmt {{ files }}"
  }
  ["shfmt"] = (Builtins.shfmt) {
    glob =
      List(
        // Code
        "dot_gitconfig",
        "dot_profile",
        // Configurations
        "**/.editorconfig",
        "**/.gitattributes",
        "**/.gitignore",
        "**/.npmrc",
      )
  }

  // Configurations
  ["hk"] = (Builtins.pkl) {
    glob = List("hk.pkl")
    check = "hk validate"
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    glob = List("hk.pkl")
    shell = null
    fix = "pkl format --write {{ files }}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    stage = false
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
