ls ...(glob **/* --exclude [**/node_modules/**, **/.git/**]) | where type == file | get name | path basename | each { | it | if ($it | str index-of . --end) > 0 { $it | str substring ($it | str index-of . --end)..-1 } else { $it | str substring 0..-1 } } | group-by --to-table | each { | it | { ext: $it.group, count: ($it.items | length) } } | sort-by count -r