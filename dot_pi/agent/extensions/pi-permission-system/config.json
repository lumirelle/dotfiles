{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "*": "allow",
      "time *": { "action": "deny", "reason": "Use Pi's bash timeout parameter instead of the time wrapper." },
      "timeout *": { "action": "deny", "reason": "Use Pi's bash timeout parameter instead of the timeout wrapper." },
      "sudo *": { "action": "deny", "reason": "Request user to execute" }
    },
    "external_directory": {
      "*": "deny",
      "/tmp": "allow",
      "~/AppData/Local/Temp/*": "allow"
    },
    "external_directory_read": {
      "~/.agents/*": "allow"
    }
  }
}
