{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "bash": {
      "*": "allow",
      "timeout *": "allow",
      "sudo *": { "action": "deny", "reason": "Request user to execute" }
    },
    "external_directory": {
      "*": "deny",
      "~/.agents/*": "allow"
    }
  }
}
