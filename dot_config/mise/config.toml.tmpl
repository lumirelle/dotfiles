[settings]
experimental = true
lockfile = true

{{ if eq .chezmoi.os "linux" }}
	# Chezmoi is not suitable for /etc/ configuration management, so we use mise dotfiles for that purpose.
	[dotfiles]
	"/etc/sysctl.d/50-unprivileged-ports.conf/unprivileged-ports".line = "net.ipv4.ip_unprivileged_port_start = 80"
{{ end }}

# System Appearance
[tools."github:Tatsu-syo/noMeiryoUI"]
os = "windows"
version = "3.4.2"
version_prefix = "TAG-"
asset_pattern = "noMeiryoUI*.zip"

# Development Environment
# -- Environment
## Drive LSP
[tools.node]
version = "latest"

## Drive .js/.ts scripts
[tools.bun]
version = "latest"

## Drive .py scripts
[tools.python]
version = "latest"

# -- CLI / TUI Tools
[tools.yazi]
version = "latest"

[tools.fd]
version = "latest"

[tools.ripgrep]
version = "latest"

[tools.lazygit]
version = "latest"

[tools.hyperfine]
version = "latest"

[tools.bottom]
version = "latest"

[tools.gdu]
version = "latest"
