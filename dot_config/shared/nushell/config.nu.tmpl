# Environment
## Mise, https://mise.jdx.dev/
use ($nu.default-config-dir | path join mise.nu)
## Starship, https://starship.rs/
mkdir ($nu.data-dir | path join "vendor/autoload")
mise exec -- starship init nu | save -f ($nu.data-dir | path join "vendor/autoload/starship.nu")
## Zoxide, https://github.com/ajeetdsouza/zoxide
mise exec -- zoxide init nushell | save -f ($nu.data-dir | path join "vendor/autoload/zoxide.nu")
## Podman
$env.PODMAN_COMPOSE_WARNING_LOGS = false

# Aliases
source aliases/sudo.nu
source aliases/built-in.nu
source aliases/exts.nu
{{ if eq .chezmoi.os "windows" }}
	source aliases/winget.nu
{{ end }}
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") }}
	source aliases/pacman.nu
{{ end }}
source aliases/git.nu
source aliases/lazygit.nu
source aliases/chezmoi.nu
source aliases/docker.nu
source aliases/degit.nu
