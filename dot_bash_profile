# Prompt UI
eval "$(starship init bash)"

# Environment
## Mise, https://mise.jdx.dev/
eval "$(mise activate bash)"
if (which chezmoi &> /dev/null); then
  export CHEZMOI_HOME=$(chezmoi source-path)
endif
## Podman
export PODMAN_COMPOSE_WARNING_LOGS=false

# Commands Aliases
alias tochezmoi='cd $CHEZMOI_HOME'
# For container management
alias docker='podman'
alias compose='podman compose'
