#!/usr/bin/env bash

set -euo pipefail

YELLOW=$'\e[0;33m'
NC=$'\e[0m'

# Helpers
want_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in
    -\? | --\?) return 0 ;;
    esac
  done
  return 1
}
nonflag_count() {
  local arg count=0
  for arg in "$@"; do
    case "$arg" in
    -*) ;;
    *) count=$((count + 1)) ;;
    esac
  done
  echo "$count"
}

# Aliases
me() {
  echo "$(git config get user.name) <$(git config get user.email)>"
}
discard() {
  if want_help "$@"; then
    echo 'Usage: git discard <...path>'
    return 0
  fi
  if [[ "$(nonflag_count "$@")" -eq 0 ]]; then
    echo 'Nothing specified, nothing discarded.'
    echo -e "${YELLOW}hint: Maybe you wanted to say 'git discard .'?${NC}"
    return 0
  fi
  local path
  for path in "$@"; do
    case "$path" in
    -\? | --\?) continue ;;
    esac
    if git ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
      if git restore --staged --worktree -- "$path" >/dev/null 2>&1; then
        echo "Restoring tracked file(s) from path: $path"
      fi
    fi
    if [[ -e "$path" ]]; then
      if git clean -fd -- "$path" >/dev/null 2>&1; then
        echo "Removing untracked file(s) from path: $path"
      fi
    else
      echo "Path does not exist: $path"
    fi
  done
}
disadd() {
  if want_help "$@"; then
    echo 'Usage: git disadd <...path>'
    return 0
  fi
  if [[ "$(nonflag_count "$@")" -eq 0 ]]; then
    echo 'Nothing specified, nothing disadded.'
    echo -e "${YELLOW}hint: Maybe you wanted to say 'git disadd .'?${NC}"
    return 0
  fi
  git reset HEAD -- "$@"
}
justmerge() {
  local current_branch merge_branches=() arg
  current_branch=$(git branch --show-current)
  for arg in "$@"; do
    case "$arg" in
    -\? | --\?)
      echo 'Usage: git justmerge <branch1> <branch2> ...'
      return 0
      ;;
    -*)
      ;;
    *)
      merge_branches+=("$arg")
      ;;
    esac
  done
  if ((${#merge_branches[@]} == 0)); then
    echo 'Usage: git justmerge <branch1> <branch2> ...'
    return 1
  fi
  local msg="chore: merge ${merge_branches[*]} into ${current_branch}"
  if git merge --message "$msg" "$@"; then
    echo "Merged \"${merge_branches[*]}\" into current ${current_branch} with default message!"
  fi
}

# Main flow
cmd=${1:-}
shift || true
case "$cmd" in
me) me "$@" ;;
discard) discard "$@" ;;
disadd) disadd "$@" ;;
justmerge) justmerge "$@" ;;
"" | -h | --help | -\? | --\?)
  cat <<'EOF'
Usage: git <alias> ...
  me
  discard <...path>
  disadd <...path>
  justmerge <branch1> <branch2> ...
EOF
  ;;
*)
  echo "Unknown command: $cmd" >&2
  exit 1
  ;;
esac
